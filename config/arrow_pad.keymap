#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Kısa basılırsa hiçbir şey yapmaz, 3 sn basılı tutulursa BT sıfırlar
        bt_clr_hold: bt_clr_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bt_clear {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&bt_clr_hold BT_CLR 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <&kp LEFT &kp RIGHT>;
        };
    };
};
